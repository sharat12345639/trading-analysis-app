<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Trading Analysis Dashboard</title>
    <link rel="stylesheet" href="/static/styles.css" />
  </head>
  <body>
    <div class="app-shell">
      <header class="topbar">
        <div>
          <p class="eyebrow">Trade intelligence</p>
          <h1>Multi-signal Trading Dashboard</h1>
        </div>
        <div class="status-pill">Analytical prototype</div>
      </header>

      <section id="summary" class="summary-grid"></section>

      <section class="panel-grid">
        <div class="panel">
          <div class="panel-header">
            <h2>Low IV opportunities</h2>
          </div>
          <div id="low-iv-list" class="chip-list"></div>
        </div>

        <div class="panel">
          <div class="panel-header">
            <h2>Gamma blast signals</h2>
          </div>
          <div id="gamma-list" class="chip-list"></div>
        </div>
      </section>

      <section class="panel full-width">
        <div class="panel-header">
          <h2>Signal watchlist</h2>
        </div>
        <table>
          <thead>
            <tr>
              <th>Symbol</th>
              <th>Type</th>
              <th>Price</th>
              <th>IV</th>
              <th>Trend</th>
              <th>Event</th>
              <th>Signal</th>
              <th>Score</th>
            </tr>
          </thead>
          <tbody id="watchlist-body"></tbody>
        </table>
      </section>
    </div>

    <script src="/static/app.js"></script>
  </body>
</html>
